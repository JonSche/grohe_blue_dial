diff --git a/components/esp-tls/esp_tls_mbedtls.c b/components/esp-tls/esp_tls_mbedtls.c
index f1a8adefb6d..00e74b563ed 100644
--- a/components/esp-tls/esp_tls_mbedtls.c
+++ b/components/esp-tls/esp_tls_mbedtls.c
@@ -19,6 +19,7 @@
 #include <errno.h>
 #include "esp_log.h"
 #include "esp_check.h"
+#include "esp_heap_caps.h" /* grohe_blue_dial diagnostic instrumentation */
 
 #ifdef CONFIG_MBEDTLS_HARDWARE_ECDSA_SIGN
 #include "ecdsa/ecdsa_alt.h"
@@ -145,7 +146,36 @@ esp_err_t esp_create_mbedtls_handle(const char *hostname, size_t hostlen, const
     mbedtls_esp_enable_debug_log(&tls->conf, CONFIG_MBEDTLS_DEBUG_LEVEL);
 #endif
 
-    if ((ret = mbedtls_ssl_setup(&tls->ssl, &tls->conf)) != 0) {
+    /* ---- grohe_blue_dial diagnostic instrumentation: heap state and the
+     * symbolic MbedTLS error name immediately around mbedtls_ssl_setup(),
+     * added to investigate MBEDTLS_ERR_SSL_ALLOC_FAILED (-0x7F00) on OTA.
+     * Local-only change to this ESP-IDF install, not part of any project
+     * repo -- see grohe_blue_dial/patches/esp_tls_mbedtls_diagnostics.patch
+     * for the reproducible diff and how to reapply it. Logged
+     * unconditionally at WARN (not gated behind CONFIG_LOG_DEFAULT_LEVEL_
+     * DEBUG/VERBOSE the way mbedtls_print_error_msg() below already is),
+     * so it shows up in a normal INFO-level build without any other
+     * sdkconfig change. Does not alter control flow: `ret` is still
+     * assigned from mbedtls_ssl_setup() exactly as before, and the
+     * existing `if (ret != 0)` handling below is untouched. */
+    ESP_LOGW(TAG, "mbedtls_ssl_setup: before: free=%u largest_free_block=%u min_free_ever=%u",
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL));
+    ret = mbedtls_ssl_setup(&tls->ssl, &tls->conf);
+    {
+        char diag_err_buf[100];
+        mbedtls_strerror(ret, diag_err_buf, sizeof(diag_err_buf));
+        ESP_LOGW(TAG,
+                 "mbedtls_ssl_setup: after: ret=-0x%04X (%s) free=%u largest_free_block=%u min_free_ever=%u",
+                 (unsigned)(-ret), diag_err_buf,
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL),
+                 (unsigned)heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL));
+    }
+    /* ---- end grohe_blue_dial diagnostic instrumentation */
+
+    if (ret != 0) {
         ESP_LOGE(TAG, "mbedtls_ssl_setup returned -0x%04X", -ret);
         mbedtls_print_error_msg(ret);
         ESP_INT_EVENT_TRACKER_CAPTURE(tls->error_handle, ESP_TLS_ERR_TYPE_MBEDTLS, -ret);
