build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
.vscode/
.DS_Store
logs/
__pycache__/
*.pyc

# Real Grohe Blue credentials (USER_ID / pre-shared key) -- never committed.
# See components/grohe_ble/include/grohe_ble/credentials_local.hpp.example.
components/grohe_ble/include/grohe_ble/credentials_local.hpp

# Real Wi-Fi credentials (used only as a one-shot SNTP time source) -- never
# committed. See
# components/time_service/include/time_service/wifi_credentials_local.hpp.example.
components/time_service/include/time_service/wifi_credentials_local.hpp

# Real OTA shared secret/token (gates the local-network Wi-Fi OTA
# endpoint) -- never committed. See
# components/ota/include/ota/ota_secret_local.hpp.example.
components/ota/include/ota/ota_secret_local.hpp

# Real provisioning shared secret/token (gates the local-network
# /provision endpoint, separate from the OTA token above) -- never
# committed. See
# components/provisioning/include/provisioning/provisioning_secret_local.hpp.example.
components/provisioning/include/provisioning/provisioning_secret_local.hpp

# Grohe Cloud refresh token (scripts/provision.sh --from-cloud) -- never
# committed. Written by scripts/grohe_cloud_bootstrap.py (the one-time,
# interactive login), read by scripts/grohe_cloud_refresh.py on every
# subsequent run. The account password itself is never written to disk at
# all, by either script.
scripts/.grohe_cloud_refresh_token
