#pragma once

// Copy this file to ota_secret_local.hpp (gitignored -- see .gitignore and
// ota_secret.cpp) and fill in your own OTA shared secret/token. Also read
// by scripts/ota.sh directly (see that script) -- one file, one place to
// edit, for both the firmware and the upload script.
//
// This token gates the plain-HTTP, local-network-only OTA endpoint (see
// ota_server.hpp) -- it is the only thing standing between "any device on
// this Wi-Fi network" and "can flash this dial's firmware", so treat it
// like a password. It is sent in the clear (no TLS -- see ota_server.hpp's
// own comment for why), so it protects against accidental/opportunistic
// uploads on a trusted local network, not against an attacker who can
// already sniff your Wi-Fi traffic. See docs/ARCHITECTURE.md's "OTA"
// section for the full security posture.
//
// Leaving this as an empty string is safe: OtaServer refuses to start the
// OTA endpoint at all rather than ever accepting an unauthenticated
// upload (see ota_server.cpp) -- the dial works exactly as it does today,
// just without Wi-Fi OTA available; USB flashing is unaffected either way.

namespace ota {

inline constexpr char kLocalOtaSecret[] = "";

}  // namespace ota
