#pragma once

// Copy this file to provisioning_secret_local.hpp (gitignored -- see
// .gitignore and provisioning_secret.cpp) and fill in your own
// provisioning shared secret/token.
//
// This token gates the plain-HTTP, local-network-only /provision endpoint
// (see provisioning_server.hpp) -- it is the only thing standing between
// "any device on this Wi-Fi network" and "can overwrite this dial's Grohe
// BLE credentials", so treat it like a password, and use a *different*
// value from components/ota/include/ota/ota_secret_local.hpp's OTA token
// -- the two endpoints are deliberately gated by separate secrets. Sent in
// the clear (no TLS -- see provisioning_server.hpp's own comment for why,
// same reasoning as OTA), so it protects against accidental/opportunistic
// requests on a trusted local network, not against an attacker who can
// already sniff your Wi-Fi traffic. See docs/ARCHITECTURE.md's
// "Provisioning" section for the full security posture.
//
// Leaving this as an empty string is safe: ProvisioningServer refuses to
// start the endpoint at all rather than ever accepting an unauthenticated
// provisioning request (see provisioning_server.cpp) -- the dial works
// exactly as it does today, just without remote (re-)provisioning
// available; the existing grohe_ble::LocalCredentialsProvider developer
// workflow is entirely unaffected either way.

namespace provisioning {

inline constexpr char kLocalProvisioningSecret[] = "";

}  // namespace provisioning
