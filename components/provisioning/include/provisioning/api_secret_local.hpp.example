#pragma once

// Copy this file to api_secret_local.hpp (gitignored -- see .gitignore
// and api_secret.cpp) and fill in your own local-API shared secret/token.
//
// This token gates the plain-HTTP, local-network-only /api/* endpoints
// (see provisioning_server.hpp) -- unlike the provisioning token
// (provisioning_secret_local.hpp), a request authenticated with *this*
// token can make the physical appliance dispense water immediately
// (POST /api/dispense), so treat it as at least as sensitive, and use a
// *different* value from both provisioning_secret_local.hpp's and
// components/ota/include/ota/ota_secret_local.hpp's tokens -- all three
// endpoints are deliberately gated by separate secrets. Sent in the
// clear (no TLS -- see provisioning_server.hpp's own comment for why,
// same reasoning as OTA/Provisioning), so it protects against
// accidental/opportunistic requests on a trusted local network, not
// against an attacker who can already sniff your Wi-Fi traffic. See
// docs/m15_ha_integration.md's security section for the full posture.
//
// Leaving this as an empty string is safe: ProvisioningServer refuses to
// register the /api/* endpoints at all rather than ever accepting an
// unauthenticated status/config/dispense/stop request (see
// provisioning_server.cpp) -- the dial works exactly as it does
// otherwise, just without the local HTTP API (and therefore the Home
// Assistant integration) available.

namespace provisioning {

inline constexpr char kLocalApiSecret[] = "";

}  // namespace provisioning
