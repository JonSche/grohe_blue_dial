#pragma once

// Copy this file to credentials_local.hpp (gitignored -- see .gitignore and
// grohe_credentials.cpp) and fill in your real Grohe Blue credentials.
//
// Both values come from the same places the Python reference implementation
// documents (grohe_blue_ble's own .env.example, docs/EVIDENCE.md):
//
//   kUserId               -- the OpenID Connect "sub" claim from the Grohe
//                            account's JWT access token.
//   kPreSharedKeyBase64   -- the Base64-encoded "presharedkey" field from
//                            GET /v3/iot/dashboard.
//
// Leaving these as empty strings still builds and runs: the appliance will
// reply INVALID_HMAC to the stop() probe (M7), which is a legitimately
// decoded ApplianceState, just not a successful one.

namespace grohe_ble {

inline constexpr char kLocalUserId[] = "";
inline constexpr char kLocalPreSharedKeyBase64[] = "";

}  // namespace grohe_ble
